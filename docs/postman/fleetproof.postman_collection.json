{
  "info": {
    "name": "FleetProof local API and i18n",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Read-only requests against synthetic local data. JSON Server is not a secure authentication backend."
  },
  "variable": [
    {
      "key": "api",
      "value": "http://127.0.0.1:3000/api/v1"
    },
    {
      "key": "frontend",
      "value": "http://localhost:4200"
    }
  ],
  "item": [
    {
      "name": "GET vehicles",
      "request": {
        "method": "GET",
        "url": "{{api}}/vehicles"
      }
    },
    {
      "name": "GET reports",
      "request": {
        "method": "GET",
        "url": "{{api}}/reports"
      }
    },
    {
      "name": "GET sourceFixtures",
      "request": {
        "method": "GET",
        "url": "{{api}}/sourceFixtures"
      }
    },
    {
      "name": "GET monitoring",
      "request": {
        "method": "GET",
        "url": "{{api}}/monitoring"
      }
    },
    {
      "name": "GET alerts",
      "request": {
        "method": "GET",
        "url": "{{api}}/alerts"
      }
    },
    {
      "name": "GET cases",
      "request": {
        "method": "GET",
        "url": "{{api}}/cases"
      }
    },
    {
      "name": "GET fleets",
      "request": {
        "method": "GET",
        "url": "{{api}}/fleets"
      }
    },
    {
      "name": "i18n es",
      "request": {
        "method": "GET",
        "url": "{{frontend}}/i18n/es.json"
      }
    },
    {
      "name": "i18n en",
      "request": {
        "method": "GET",
        "url": "{{frontend}}/i18n/en.json"
      }
    }
  ]
}

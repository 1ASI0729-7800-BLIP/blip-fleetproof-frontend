{
  "name": "blip-fleetproof-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build",
    "api": "npm run server",
    "dev": "concurrently -k \"npm:api\" \"npm:start\"",
    "test": "ng test",
    "lint": "eslint src --max-warnings=0",
    "ng": "ng",
    "watch": "ng build --watch --configuration development",
    "server": "json-server --watch db.json --routes routes.json --host 127.0.0.1 --port 3000"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/animations": "~22.2.1",
    "@angular/cdk": "~22.2.1",
    "@angular/common": "~22.2.1",
    "@angular/compiler": "~22.2.1",
    "@angular/core": "~22.2.1",
    "@angular/forms": "~22.2.1",
    "@angular/material": "~22.2.1",
    "@angular/platform-browser": "~22.2.1",
    "@angular/router": "~22.2.1",
    "@fontsource/inter": "^5.3.0",
    "@lucide/angular": "^1.52.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "jspdf": "^4.2.1",
    "papaparse": "^5.7.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.3"
  },
  "overrides": {
    "piscina": "^5.3.2"
  },
  "devDependencies": {
    "@angular/build": "~22.2.1",
    "@angular/cli": "~22.2.1",
    "@angular/compiler-cli": "~22.2.1",
    "@types/jasmine": "^5.1.15",
    "@types/node": "^24.19.1",
    "@types/papaparse": "^5.5.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^5.13.0",
    "json-server": "0.17.4",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
